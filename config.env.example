# monad-tg-bot config — copy to config.env and fill in (chmod 600)
# Bot token from @BotFather:
BOT_TOKEN=
# Authorized chat IDs, comma-separated. Get yours by sending /id to the bot.
ALLOWED_CHAT_IDS=
# Background check interval, seconds
CHECK_INTERVAL=60
# Disk usage warning threshold for / , percent
DISK_WARN_PCT=85
# Sync-lag warning threshold, seconds
SYNC_LAG_WARN_SEC=30

# UI language: en (default), ru, or de. Also switchable at runtime with the 🌐 button or /lang.
LANG=en
